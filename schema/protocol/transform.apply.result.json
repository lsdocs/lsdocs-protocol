    "Paragraph": {
      "description": "See [`Node::Paragraph`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Inline content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Raw": {
      "description": "See [`Node::Raw`].",
      "type": "object",
      "properties": {
