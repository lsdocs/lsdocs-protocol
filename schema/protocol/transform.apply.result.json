      "description": "A byte range within the document's source text.\n\nOffsets count UTF-8 bytes from the start of the source, and `end` is\nexclusive. The source file is the enclosing [`Document::source`].",
      "type": "object",
      "properties": {
        "end": {
          "description": "Offset one past the last byte.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start": {
          "description": "Offset of the first byte.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
