{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransformApplyResult",
  "description": "Result of [`request::TransformApply`].",
  "type": "object",
  "properties": {
    "diagnostics": {
      "description": "Problems found.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "document": {
      "description": "The transformed document.",
      "$ref": "#/$defs/Document"
    }
  },
  "required": [
    "document"
  ],
  "$defs": {
    "Admonition": {
      "description": "See [`Node::Admonition`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "kind": {
          "description": "What kind of callout, e.g. `\"note\"`, `\"tip\"`, `\"warning\"`.",
          "type": "string"
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "A title replacing the kind's default one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "Align": {
      "description": "Horizontal alignment of a table column.",
      "oneOf": [
        {
          "description": "No alignment specified.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Left-aligned.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Centered.",
          "type": "string",
          "const": "center"
        },
        {
          "description": "Right-aligned.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "Anchor": {
      "description": "See [`Node::Anchor`].",
      "type": "object",
      "properties": {
        "id": {
          "description": "The anchor identifier.",
          "type": "string"
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "BlockQuote": {
      "description": "See [`Node::BlockQuote`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Quoted content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Caption": {
      "description": "See [`Node::Caption`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CodeBlock": {
      "description": "See [`Node::CodeBlock`].",
      "type": "object",
      "properties": {
        "info": {
          "description": "Anything after the language on a Markdown fence's info line.",
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "description": "Language name, e.g. `\"rust\"`, if given.",
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "The code itself.",
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "Custom": {
      "description": "See [`Node::Custom`].",
      "type": "object",
      "properties": {
        "attrs": {
          "description": "Arbitrary attributes.",
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "description": "Child nodes, if any.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "kind": {
          "description": "The plugin-defined kind, e.g. `\"mermaid\"`. Selected as\n`\"custom:<kind>\"`.",
          "type": "string"
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "DefinitionDescription": {
      "description": "See [`Node::DefinitionDescription`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DefinitionList": {
      "description": "See [`Node::DefinitionList`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Terms and descriptions, in order.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DefinitionTerm": {
      "description": "See [`Node::DefinitionTerm`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Inline content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Diagnostic": {
      "description": "A problem to report to the user, modeled on LSP diagnostics.",
      "type": "object",
      "properties": {
        "code": {
          "description": "A short identifier for the kind of problem, e.g. `\"broken-link\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        },
        "severity": {
          "description": "How serious the problem is.",
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "description": "Source file the problem is in, relative to the source directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "description": "Where in `source` the problem is.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "severity",
        "message"
      ]
    },
    "Document": {
      "description": "A parsed source document.",
      "type": "object",
      "properties": {
        "children": {
          "description": "Top-level nodes.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "metadata": {
          "description": "Front matter and other document-level data.",
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "description": "Path of the source file, relative to the site's source directory,\nwith `/` separators.",
          "type": "string"
        }
      },
      "required": [
        "source"
      ]
    },
    "Emphasis": {
      "description": "See [`Node::Emphasis`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Emphasized content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Figure": {
      "description": "See [`Node::Figure`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Content, then an optional caption.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "id": {
          "description": "Anchor identifier, e.g. for linking to the figure.",
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FootnoteDefinition": {
      "description": "See [`Node::FootnoteDefinition`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "label": {
          "description": "The label references use.",
          "type": "string"
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ]
    },
    "FootnoteReference": {
      "description": "See [`Node::FootnoteReference`].",
      "type": "object",
      "properties": {
        "label": {
          "description": "The footnote's label, e.g. `\"1\"` or `\"note\"`.",
          "type": "string"
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ]
    },
    "Heading": {
      "description": "See [`Node::Heading`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Inline content.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "id": {
          "description": "Anchor identifier, only for headings that are not a section's\ntitle (a section's anchor is [`Section::id`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "description": "Heading level, from 1 (top) to 6. For a section title this is\nthe level as written, which may skip levels; the nesting of\nsections is the structure.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level"
      ]
    },
    "Image": {
      "description": "See [`Node::Image`].",
      "type": "object",
      "properties": {
        "alt": {
          "description": "Alternative text.",
          "type": "string",
          "default": ""
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "Image title (often shown as a tooltip).",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Image location.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "InlineCode": {
      "description": "See [`Node::InlineCode`].",
      "type": "object",
      "properties": {
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "The code.",
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "LineBreak": {
      "description": "See [`Node::LineBreak`].",
      "type": "object",
      "properties": {
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Link": {
      "description": "See [`Node::Link`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "Link text.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "description": "Where the link points inside the site, if it is a\ncross-reference. Renderers prefer it over `url`.",
          "anyOf": [
            {
              "$ref": "#/$defs/LinkTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "Link title (often shown as a tooltip).",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Link target.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "LinkTarget": {
      "description": "The site-internal destination of a [`Link`].\n\nA resolved target names a document, an anchor, or both (an anchor alone\nmeans the linking document). An unresolved one has only a `label`, to be\nlooked up among the anchors of every document, e.g. by a transformer.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Anchor id within the target document.",
          "type": [
            "string",
            "null"
          ]
        },
        "document": {
          "description": "Source path of the target document, relative to the source\ndirectory with `/` separators.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "A label naming the target, not yet resolved to a document and\nanchor.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "List": {
      "description": "See [`Node::List`].",
      "type": "object",
      "properties": {
        "children": {
          "description": "The list's items.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "ordered": {
          "description": "Whether items are numbered.",
          "type": "boolean",
          "default": false
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "description": "Number of the first item of an ordered list, if not 1.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "ListItem": {
      "description": "See [`Node::ListItem`].",
      "type": "object",
      "properties": {
        "checked": {
          "description": "For task list items, whether the box is checked.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "children": {
          "description": "Content of the item.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Math": {
      "description": "See [`Node::Math`].",
      "type": "object",
      "properties": {
        "display": {
          "description": "Whether it is set on its own line rather than inline.",
          "type": "boolean",
          "default": false
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "The formula, e.g. in TeX notation.",
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "Node": {
      "description": "A node in the document tree.\n\nSerialized with a `type` tag holding the [`Node::kind`] name, for core\nkinds, followed by the variant's fields.",
      "oneOf": [
        {
          "description": "A titled section; by convention its first child is a [`Heading`].",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "section"
            }
          },
          "$ref": "#/$defs/Section",
          "required": [
            "type"
          ]
        },
        {
          "description": "A heading.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "heading"
            }
          },
          "$ref": "#/$defs/Heading",
          "required": [
            "type"
          ]
        },
        {
          "description": "A paragraph.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            }
          },
          "$ref": "#/$defs/Paragraph",
          "required": [
            "type"
          ]
        },
        {
          "description": "A bulleted or numbered list whose children are list items.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            }
          },
          "$ref": "#/$defs/List",
          "required": [
            "type"
          ]
        },
        {
          "description": "An item of a [`List`].",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list_item"
            }
          },
          "$ref": "#/$defs/ListItem",
          "required": [
            "type"
          ]
        },
        {
          "description": "A block quote.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "block_quote"
            }
          },
          "$ref": "#/$defs/BlockQuote",
          "required": [
            "type"
          ]
        },
        {
          "description": "A block of code or preformatted text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code_block"
            }
          },
          "$ref": "#/$defs/CodeBlock",
          "required": [
            "type"
          ]
        },
        {
          "description": "A table whose children are table rows.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            }
          },
          "$ref": "#/$defs/Table",
          "required": [
            "type"
          ]
        },
        {
          "description": "A row of a [`Table`] whose children are table cells.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table_row"
            }
          },
          "$ref": "#/$defs/TableRow",
          "required": [
            "type"
          ]
        },
        {
          "description": "A cell of a [`TableRow`].",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table_cell"
            }
          },
          "$ref": "#/$defs/TableCell",
          "required": [
            "type"
          ]
        },
        {
          "description": "A horizontal rule.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "thematic_break"
            }
          },
          "$ref": "#/$defs/ThematicBreak",
          "required": [
            "type"
          ]
        },
        {
          "description": "Content passed through verbatim to renderers of a matching format,\nsuch as inline HTML in Markdown.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "raw"
            }
          },
          "$ref": "#/$defs/Raw",
          "required": [
            "type"
          ]
        },
        {
          "description": "Plain text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "$ref": "#/$defs/Text",
          "required": [
            "type"
          ]
        },
        {
          "description": "Emphasized (usually italic) text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "emphasis"
            }
          },
          "$ref": "#/$defs/Emphasis",
          "required": [
            "type"
          ]
        },
        {
          "description": "Strongly emphasized (usually bold) text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strong"
            }
          },
          "$ref": "#/$defs/Strong",
          "required": [
            "type"
          ]
        },
        {
          "description": "Inline code.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "inline_code"
            }
          },
          "$ref": "#/$defs/InlineCode",
          "required": [
            "type"
          ]
        },
        {
          "description": "A hyperlink.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link"
            }
          },
          "$ref": "#/$defs/Link",
          "required": [
            "type"
          ]
        },
        {
          "description": "An image.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "$ref": "#/$defs/Image",
          "required": [
            "type"
          ]
        },
        {
