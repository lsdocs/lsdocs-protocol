          "default": [],
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "id": {
          "description": "Anchor identifier for linking to the section. Set by the parser\nif the author gave one; otherwise the host derives one from the\ntitle.",
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "description": "Where this node came from in the source, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Severity": {
      "description": "Severity of a [`Diagnostic`].",
      "oneOf": [
        {
          "description": "The build fails.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "Probably a mistake, but the build continues.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Worth knowing.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "A suggestion.",
          "type": "string",
          "const": "hint"
        }
      ]
    },
