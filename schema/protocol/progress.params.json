{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressParams",
  "description": "Parameters of [`notification::Progress`].",
  "type": "object",
  "properties": {
    "message": {
      "description": "What is being worked on.",
      "type": "string"
    },
    "percentage": {
      "description": "Percent complete, 0-100, if known.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "required": [
    "message"
  ]
}
