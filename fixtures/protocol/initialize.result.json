{
  "protocol_version": "1.0-rc.0",
  "plugin": {
    "name": "transform-toc",
    "version": "0.1.0"
  },
  "capabilities": {
    "parse": {
      "extensions": [
        "md",
        "markdown"
      ]
    },
    "transform": {
      "nodes": [
        "heading",
        "custom:admonition"
      ],
      "each": true
    },
    "render": {
      "formats": [
        "html"
      ],
      "all": true
    },
    "max_concurrency": 1,
    "cache": "template:3f9a2c",
    "syntax": {
      "directives": [
        {
          "name": "versionadded",
          "required_arguments": 1,
          "final_argument_whitespace": true,
          "options": {
            "class": "value"
          },
          "content": "blocks"
        }
      ],
      "roles": [
        {
          "name": "kbd"
        }
      ]
    }
  },
  "config_files": [
    "lsdocs/toc/settings.toml"
  ]
}
